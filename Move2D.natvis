<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="Vec2">
    <DisplayString>({x,g}, {y,g})</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
    </Expand>
  </Type>

  <Type Name="Move2D">
    <DisplayString Condition="type==2">seq={seqNum} LINE p0=({p_0.x,g},{p_0.y,g}) p1=({p_1.x,g},{p_1.y,g}) feed={feed,g} valid={valid}</DisplayString>
    <DisplayString Condition="type==3">seq={seqNum} ARC p0=({p_0.x,g},{p_0.y,g}) p1=({p_1.x,g},{p_1.y,g}) c=({center.x,g},{center.y,g}) r={radius,g} dir={arcDir} valid={valid}</DisplayString>
    <DisplayString>seq={seqNum} type={type} p0=({p_0.x,g},{p_0.y,g}) p1=({p_1.x,g},{p_1.y,g}) z0={z_0,g} z1={z_1,g} valid={valid}</DisplayString>
    <Expand>
      <Item Name="seqNum">seqNum</Item>
      <Item Name="type">type</Item>
      <Item Name="compMode">compMode</Item>
      <Item Name="valid">valid</Item>
      <Item Name="hasXY">hasXY</Item>
      <Item Name="hasZ">hasZ</Item>
      <Item Name="feed">feed</Item>
      <Item Name="z_0">z_0</Item>
      <Item Name="z_1">z_1</Item>
      <Item Name="arcDir">arcDir</Item>
      <Item Name="radius">radius</Item>

      <Item Name="p0">p_0</Item>
      <Item Name="p1">p_1</Item>
      <Item Name="center">center</Item>
      <Item Name="startDir">startDir</Item>
      <Item Name="endDir">endDir</Item>
    </Expand>
  </Type>
</AutoVisualizer>
